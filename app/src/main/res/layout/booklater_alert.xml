<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_8"
        android:clipChildren="true"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/dp_8">

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txt_scheduletrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center"
                android:padding="@dimen/dp_8"
                android:text="@string/schedule_trip"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txt_pick_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center"
                android:padding="@dimen/dp_8"
                android:text=""
                android:textColor="@color/black"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"

                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="15dp"
                        android:paddingStart="8dp"
                        android:visibility="visible"
                        app:srcCompat="@drawable/ic_pickup_dot" />

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:paddingStart="8dp"
                        android:visibility="visible"
                        app:srcCompat="@drawable/ic_fleetera_line" />

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:paddingStart="8dp"
                        android:visibility="visible"
                        app:srcCompat="@drawable/ic_dropoff_pin" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout xmlns:card_view="http://schemas.android.com/apk/res-auto"
                            android:id="@+id/pickup_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"


                            android:layout_marginEnd="@dimen/dp_12"

                            card_view:cardCornerRadius="10dp"
                            card_view:cardElevation="@dimen/dp_5">

                            <LinearLayout
                                android:id="@+id/pick_lay"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_alignParentTop="true"
                                android:layout_toEndOf="@+id/pickup_pinlay"
                                android:clickable="true"
                                android:focusable="true"

                                android:gravity="center"
                                android:orientation="horizontal"
                                >

                                <ImageView
                                    android:id="@+id/pick_pin"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_centerVertical="true"
                                    android:layout_gravity="center"
                                    android:paddingLeft="8dp"
                                    android:visibility="gone"
                                    app:srcCompat="@drawable/ic_fleetera_pick_point" />

                                <TextView
                                    android:id="@+id/txt_pickup"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.8"
                                    android:background="@android:color/transparent"
                                    android:drawablePadding="@dimen/dp_10"
                                    android:fadingEdge="horizontal"
                                    android:gravity="center_vertical"
                                    android:hint="@string/picklocation"
                                    android:lines="1"
                                    android:marqueeRepeatLimit="marquee_forever"

                                    android:paddingTop="@dimen/taxi__search_padding_medium"
                                    android:paddingEnd="@dimen/pad_15dp"
                                    android:paddingBottom="@dimen/taxi__search_padding_medium"
                                    android:scrollHorizontally="true"
                                    android:singleLine="true"

                                    android:textColor="@color/black"
                                    android:textColorHint="@color/hintcolor"
                                    android:textSize="14sp" />


                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"

                            android:background="#e6ebec" />


                        <LinearLayout
                            android:id="@+id/drop_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/pickup_card"
                            android:layout_marginEnd="@dimen/dp_12"



                            app:cardCornerRadius="10dp">

                            <LinearLayout
                                android:id="@+id/drop_lay"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_alignParentTop="true"
                                android:layout_toEndOf="@+id/pickup_pinlay"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:orientation="horizontal"
                                >


                                <TextView
                                    android:id="@+id/txt_drop"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.8"
                                    android:background="@android:color/transparent"
                                    android:drawablePadding="@dimen/dp_10"
                                    android:fadingEdge="horizontal"
                                    android:gravity="center_vertical"
                                    android:hint="@string/droploc"
                                    android:lines="1"
                                    android:marqueeRepeatLimit="marquee_forever"

                                    android:paddingTop="@dimen/taxi__search_padding_medium"
                                    android:paddingEnd="@dimen/pad_15dp"
                                    android:paddingBottom="@dimen/taxi__search_padding_medium"
                                    android:scrollHorizontally="true"
                                    android:singleLine="true"

                                    android:textColor="@color/black"
                                    android:textColorHint="@color/hintcolor"
                                    android:textSize="14sp" />


                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>




            <com.bluetaxi.driver.utils.ListViewEX
                android:id="@+id/testLay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp_5"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txt_scheduletrip" />

            <View
                android:id="@+id/dividerOne"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/dp_5"

                android:background="@color/textviewcolor_light"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/testLay" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDecline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp_5"
                    android:background="@color/black"
                    android:text="@string/decline"
                    android:layout_weight="1"
                    android:textColor="@color/white"
                    />

                <View
                    android:layout_width="1dp"
                    android:layout_height="50dp"
                    android:background="@color/textviewcolor_light"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/btnDecline"
                    app:layout_constraintStart_toEndOf="@id/btnDecline"
                    app:layout_constraintTop_toBottomOf="@id/dividerOne" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAccept"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp_5"
                    android:layout_weight="1"
                    android:background="@color/app_theme_color"
                    android:text="@string/accept"
                    android:textColor="@color/white"
                    />
            </LinearLayout>


        </LinearLayout>
    </androidx.cardview.widget.CardView>


</LinearLayout>